---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { createClient } from '@libsql/client';

const db = createClient({ url: process.env.CMS_LIBSQL_URL || 'file:./twonature.db' });

const sections = await db.execute({
  sql: "SELECT slug, title, updatedAt FROM StudioCMSPageData WHERE slug LIKE 'section-%' ORDER BY updatedAt DESC",
  args: [],
});

const sectionCards = [
  { slug: 'section-hero', title: 'Hero Section', icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
  { slug: 'section-about', title: 'About Section', icon: 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
  { slug: 'section-property-mara-river', title: 'Mara River Property', icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4' },
  { slug: 'section-property-nyaruswiga', title: 'Nyaruswiga Property', icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4' },
  { slug: 'section-wilderness', title: 'Wilderness Section', icon: 'M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z' },
  { slug: 'section-experiences', title: 'Experiences Section', icon: 'M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
  { slug: 'section-sustainability', title: 'Sustainability Section', icon: 'M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
  { slug: 'section-trip-planning', title: 'Trip Planning Section', icon: 'M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7' },
  { slug: 'section-footer', title: 'Footer Section', icon: 'M4 6h16M4 12h16M4 18h16' },
];
---

<AdminLayout title="Dashboard">
  <div class="mb-8">
    <h2 class="font-display text-3xl text-gold-cream mb-2">Welcome back, Admin</h2>
    <p class="text-gold-cream/50">Manage your homepage content and settings</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
    {sectionCards.map((section) => {
      const sectionData = sections.rows.find(r => r.slug === section.slug);
      const lastUpdated = sectionData?.updatedAt ? new Date(sectionData.updatedAt as string).toLocaleDateString() : 'Never';
      return (
        <a href={`/admin/sections/${section.slug}`} class="card block group">
          <div class="flex items-start justify-between mb-4">
            <div class="w-12 h-12 bg-gold/10 rounded flex items-center justify-center group-hover:bg-gold/20 transition-colors">
              <svg class="w-6 h-6 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={section.icon}></path>
              </svg>
            </div>
            <span class="text-xs text-gold-cream/30">{lastUpdated}</span>
          </div>
          <h3 class="font-heading uppercase tracking-wider text-gold-cream text-sm mb-1">{section.title}</h3>
          <p class="text-gold-cream/40 text-xs">Click to edit content</p>
        </a>
      );
    })}
  </div>

  <div class="card">
    <h3 class="font-heading uppercase tracking-wider text-gold text-sm mb-4">Quick Actions</h3>
    <div class="flex flex-wrap gap-4">
      <a href="/" target="_blank" class="btn-gold">Preview Site</a>
      <a href="/admin/settings" class="btn-gold">Edit Settings</a>
    </div>
  </div>
</AdminLayout>
