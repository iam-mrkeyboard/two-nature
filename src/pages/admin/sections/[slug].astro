---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { runSDK, SDKCoreJs } from 'studiocms:sdk';

const slug = Astro.params.slug;

if (!slug) {
  return Astro.redirect('/admin/sections');
}

const page = await runSDK(SDKCoreJs.GET.page.bySlug(slug));

let content: Record<string, unknown> = {};

if (page) {
  if (page.defaultContent?.content) {
    try {
      content = JSON.parse(page.defaultContent.content);
    } catch {
      content = {};
    }
  }
}

const sectionConfig: Record<string, { fields: string[]; title: string }> = {
  'section-hero': {
    title: 'Hero Section',
    fields: ['subtitle', 'title', 'backgroundImage', 'showStars'],
  },
  'section-about': {
    title: 'About Section',
    fields: ['subtitle', 'title', 'description', 'imageUrl', 'ctaText', 'ctaLink'],
  },
  'section-property-mara-river': {
    title: 'Mara River Property',
    fields: ['location', 'title', 'description', 'imageUrls', 'ctaText', 'ctaLink'],
  },
  'section-property-nyaruswiga': {
    title: 'Nyaruswiga Property',
    fields: ['location', 'title', 'description', 'imageUrls', 'ctaText', 'ctaLink'],
  },
  'section-wilderness': {
    title: 'Wilderness Section',
    fields: ['title', 'description', 'imageUrl'],
  },
  'section-experiences': {
    title: 'Experiences Section',
    fields: ['subtitle', 'title', 'description', 'imageUrls', 'features'],
  },
  'section-sustainability': {
    title: 'Sustainability Section',
    fields: ['subtitle', 'title', 'description', 'motto', 'quote', 'bgImage'],
  },
  'section-trip-planning': {
    title: 'Trip Planning Section',
    fields: ['title', 'subtitle', 'features', 'ctaText', 'ctaLink', 'imageUrl'],
  },
  'section-footer': {
    title: 'Footer Section',
    fields: ['logoUrl', 'newsletterText', 'newsletterSubtext', 'phone', 'address', 'email', 'socialLinks', 'navItems', 'legalLinks'],
  },
};

const config = sectionConfig[slug] || { title: 'Section', fields: [] };
---

<AdminLayout title={config.title}>
  <div class="mb-8">
    <a href="/admin/sections" class="text-gold-cream/50 hover:text-gold transition-colors text-sm mb-2 inline-block">&larr; Back to Sections</a>
    <h2 class="font-display text-2xl text-gold-cream">{config.title}</h2>
  </div>

  <form id="sectionForm" class="max-w-3xl space-y-6" data-slug={slug}>
    {config.fields.map((field) => {
      const value = content[field] as string | undefined;
      const label = field.replace(/([A-Z])/g, ' $1').replace(/^./, (s) => s.toUpperCase());

      if (field === 'description' || field === 'quote') {
        return (
          <div>
            <label class="block font-heading uppercase tracking-wider text-gold text-xs mb-2">{label}</label>
            <textarea
              id={`editor-${field}`}
              name={field}
              rows={4}
              class="w-full"
              data-rich
            >{value || ''}</textarea>
          </div>
        );
      }

      if (field === 'imageUrls' || field === 'features' || field === 'phone' || field === 'socialLinks' || field === 'navItems' || field === 'legalLinks') {
        const arrValue = content[field] as unknown[] | undefined;
        return (
          <div>
            <label class="block font-heading uppercase tracking-wider text-gold text-xs mb-2">{label} (JSON array)</label>
            <textarea
              name={field}
              rows={4}
              class="w-full font-mono text-sm"
            >{JSON.stringify(arrValue || [], null, 2)}</textarea>
          </div>
        );
      }

      if (field === 'showStars') {
        return (
          <div class="flex items-center gap-3">
            <input type="checkbox" name={field} checked={(content[field] as boolean) !== false} class="w-4 h-4 accent-gold" />
            <label class="font-heading uppercase tracking-wider text-gold-cream/70 text-sm">{label}</label>
          </div>
        );
      }

      if (field.endsWith('Image') || field.endsWith('Url') || field === 'logoUrl' || field === 'bgImage') {
        return (
          <div>
            <label class="block font-heading uppercase tracking-wider text-gold text-xs mb-2">{label}</label>
            <div class="flex gap-4 items-start">
              <div class="flex-1">
                <input type="text" name={field} value={value || ''} class="w-full" placeholder="/images/..." id={`input-${field}`} />
                {value && <img src={value} alt="" class="mt-2 max-h-32 rounded border border-gold/20" />}
              </div>
              <div class="upload-zone w-32 h-32 border-2 border-dashed border-gold/30 rounded flex flex-col items-center justify-center cursor-pointer hover:border-gold/60 transition-colors" data-field={field}>
                <svg class="w-6 h-6 text-gold/50 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
                </svg>
                <span class="text-gold/50 text-xs">Drop image</span>
              </div>
            </div>
          </div>
        );
      }

      return (
        <div>
          <label class="block font-heading uppercase tracking-wider text-gold text-xs mb-2">{label}</label>
          <input type="text" name={field} value={value || ''} class="w-full" />
        </div>
      );
    })}

    <div class="flex items-center gap-4 pt-6 border-t border-gold/20">
      <button type="submit" class="btn-gold" id="saveBtn">Save Changes</button>
      <a href="/" target="_blank" class="text-gold-cream/50 hover:text-gold transition-colors text-sm">Preview Site</a>
    </div>
  </form>

  <div id="saveStatus" class="mt-4 hidden">
    <span class="text-gold text-sm">Changes saved successfully!</span>
  </div>
</AdminLayout>

<script>
  import tinymce from 'tinymce/tinymce';

  const form = document.getElementById('sectionForm') as HTMLFormElement;
  const saveBtn = document.getElementById('saveBtn') as HTMLButtonElement;
  const saveStatus = document.getElementById('saveStatus');
  const slug = form?.dataset.slug;

  const textareas = document.querySelectorAll('textarea[data-rich]');
  textareas.forEach((textarea) => {
    tinymce.init({
      target: textarea as HTMLTextAreaElement,
      plugins: 'lists link bullist numlist hr wordcount',
      menubar: false,
      statusbar: false,
      height: 300,
      skin: 'oxide-dark',
      content_css: 'dark',
      toolbar: 'undo redo | bullist numlist | link hr | wordcount',
      setup: (editor) => {
        editor.on('change', () => {
          editor.save();
        });
      },
    });
  });

  const uploadZones = document.querySelectorAll('.upload-zone');
  uploadZones.forEach((zone) => {
    const htmlZone = zone as HTMLElement;
    const field = htmlZone.dataset.field;
    const input = document.getElementById(`input-${field}`) as HTMLInputElement;

    htmlZone.addEventListener('click', () => {
      const fileInput = document.createElement('input');
      fileInput.type = 'file';
      fileInput.accept = 'image/*';
      fileInput.onchange = async () => {
        const file = fileInput.files?.[0];
        if (file) {
          await uploadFile(file, input, htmlZone);
        }
      };
      fileInput.click();
    });

    htmlZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      htmlZone.classList.add('border-gold', 'bg-gold/5');
    });

    htmlZone.addEventListener('dragleave', () => {
      htmlZone.classList.remove('border-gold', 'bg-gold/5');
    });

    htmlZone.addEventListener('drop', async (e) => {
      e.preventDefault();
      htmlZone.classList.remove('border-gold', 'bg-gold/5');
      if (!e.dataTransfer) return;
      const file = e.dataTransfer.files[0];
      if (file && file.type.startsWith('image/')) {
        await uploadFile(file, input, htmlZone);
      }
    });
  });

  async function uploadFile(file: File, input: HTMLInputElement, zone: HTMLElement) {
    zone.innerHTML = '<span class="text-gold text-xs">Uploading...</span>';
    const formData = new FormData();
    formData.append('image', file);
    formData.append('section', slug || 'uploads');

    try {
      const response = await fetch('/api/admin/upload', {
        method: 'POST',
        body: formData,
      });
      const data = await response.json();
      if (data.success) {
        input.value = data.url;
        zone.innerHTML = '<svg class="w-6 h-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>';
        setTimeout(() => {
          zone.innerHTML = '<svg class="w-6 h-6 text-gold/50 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg><span class="text-gold/50 text-xs">Drop image</span>';
        }, 2000);
      } else {
        zone.innerHTML = '<span class="text-red-500 text-xs">Failed</span>';
      }
    } catch {
      zone.innerHTML = '<span class="text-red-500 text-xs">Error</span>';
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    saveBtn.disabled = true;
    saveBtn.textContent = 'Saving...';

    textareas.forEach((textarea) => {
      const editor = tinymce.get(textarea.id);
      if (editor) {
        editor.save();
      }
    });

    const formData = new FormData(form);
    const data: Record<string, unknown> = {};

    for (const [key, value] of formData.entries()) {
      if (key === 'showStars') {
        data[key] = formData.has('showStars');
      } else if (key === 'imageUrls' || key === 'features' || key === 'phone' || key === 'socialLinks' || key === 'navItems' || key === 'legalLinks') {
        try {
          data[key] = JSON.parse(value as string);
        } catch {
          data[key] = value;
        }
      } else {
        data[key] = value;
      }
    }

    try {
      const response = await fetch(`/api/admin/sections/${slug}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (response.ok) {
        saveStatus?.classList.remove('hidden');
        setTimeout(() => saveStatus?.classList.add('hidden'), 3000);
      } else {
        alert('Failed to save changes');
      }
    } catch (error) {
      alert('Error saving changes');
    }

    saveBtn.disabled = false;
    saveBtn.textContent = 'Save Changes';
  });
</script>
