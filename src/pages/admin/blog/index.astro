---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Blog">
  <div class="mb-8 flex items-center justify-between">
    <div>
      <h2 class="font-display text-2xl text-gold-cream mb-2">Blog Posts</h2>
      <p class="text-gold-cream/50">Manage your blog content</p>
    </div>
    <a href="/admin/blog/new" class="btn-gold">+ New Post</a>
  </div>

  <div id="blogList" class="space-y-4">
    <div class="card text-center text-gold-cream/30 py-8">Loading posts...</div>
  </div>
</AdminLayout>

<script>
  const blogList = document.getElementById('blogList');

  async function loadPosts() {
    try {
      const res = await fetch('/api/admin/blog');
      const data = await res.json();
      if (data.success && blogList) {
        if (data.posts.length === 0) {
          blogList.innerHTML = '<div class="card text-center text-gold-cream/30 py-8">No blog posts yet. Create your first post!</div>';
          return;
        }

        blogList.innerHTML = data.posts.map((post: { id: string; slug: string; title: string; description: string; draft: boolean; updatedAt: string; heroImage: string }) => `
          <div class="card flex items-center justify-between" data-slug="${post.slug}">
            <div class="flex items-center gap-4 flex-1">
              ${post.heroImage ? `<img src="${post.heroImage}" alt="" class="w-16 h-16 object-cover rounded border border-gold/20" />` : '<div class="w-16 h-16 bg-gold/10 rounded flex items-center justify-center"><svg class="w-8 h-8 text-gold/30" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path></svg></div>'}
              <div class="flex-1">
                <h3 class="font-heading uppercase tracking-wider text-gold-cream text-sm mb-1">${post.title}</h3>
                <p class="text-gold-cream/40 text-xs truncate">${post.description || 'No description'}</p>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <span class="text-xs ${post.draft ? 'text-yellow-500' : 'text-green-500'}">${post.draft ? 'Draft' : 'Published'}</span>
              <span class="text-xs text-gold-cream/30 hidden sm:block">${new Date(post.updatedAt).toLocaleDateString()}</span>
              <a href="/admin/blog/${post.slug}" class="btn-gold text-xs px-4 py-2">Edit</a>
              <button type="button" class="delete-btn text-red-500 hover:text-red-400 transition-colors" data-slug="${post.slug}">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
              </button>
            </div>
          </div>
        `).join('');

        document.querySelectorAll('.delete-btn').forEach((btn) => {
          btn.addEventListener('click', async () => {
            if (confirm('Are you sure you want to delete this post?')) {
              const slug = (btn as HTMLElement).dataset.slug;
              const res = await fetch(`/api/admin/blog/${slug}`, { method: 'DELETE' });
              if (res.ok) {
                await loadPosts();
              } else {
                alert('Failed to delete post');
              }
            }
          });
        });
      }
    } catch {
      if (blogList) {
        blogList.innerHTML = '<div class="card text-center text-red-500 py-8">Failed to load posts</div>';
      }
    }
  }

  loadPosts();
</script>
