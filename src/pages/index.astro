---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import HeroSlider from '../components/HeroSlider.astro';
import BookingBar from '../components/BookingBar.astro';
import AboutSection from '../components/AboutSection.astro';
import PropertyShowcase from '../components/PropertyShowcase.astro';
import WildernessSection from '../components/WildernessSection.astro';
import ExperiencesSection from '../components/ExperiencesSection.astro';
import SustainabilitySection from '../components/SustainabilitySection.astro';
import BlogCarousel from '../components/BlogCarousel.astro';
import TripPlanningCTA from '../components/TripPlanningCTA.astro';
import Footer from '../components/Footer.astro';
import MobileStickyBar from '../components/MobileStickyBar.astro';

const maraRiverImages = [
  '/images/mara-river/bedroom1.webp',
  '/images/mara-river/pool.webp',
  '/images/mara-river/bedroom2.webp',
];

const nyaruswigaImages = [
  '/images/nyaruswiga/tent1.webp',
  '/images/nyaruswiga/family-lounge.webp',
  '/images/nyaruswiga/tent2.webp',
];
---

<Layout>
  <Navigation />

  <HeroSlider>
    <BookingBar slot="booking" />
  </HeroSlider>

  <main>
    <AboutSection />

    <PropertyShowcase
      location="Serengeti National Park, Tanzania"
      title="One Nature Mara River"
      description="Seven luxurious villas situated in the heart of the Great Migration River Crossing, offering an unparalleled safari experience with breathtaking views of the Mara River."
      images={maraRiverImages}
      ctaLink="/mara-river/"
    />

    <PropertyShowcase
      location="Serengeti National Park, Tanzania"
      title="One Nature Nyaruswiga"
      description="Fourteen ultra-luxurious tents nestled in the Central Serengeti, offering an exclusive and intimate safari experience with world-class amenities and stunning views."
      images={nyaruswigaImages}
      ctaLink="/nyaruswiga/"
      reversed
    />

    <WildernessSection />

    <ExperiencesSection />

    <SustainabilitySection />

    <BlogCarousel />

    <TripPlanningCTA />
  </main>

  <Footer />

  <MobileStickyBar />
</Layout>
