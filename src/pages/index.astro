---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import HeroSlider from '../components/HeroSlider.astro';
import BookingBar from '../components/BookingBar.astro';
import AboutSection from '../components/AboutSection.astro';
import PropertyShowcase from '../components/PropertyShowcase.astro';
import WildernessSection from '../components/WildernessSection.astro';
import ExperiencesSection from '../components/ExperiencesSection.astro';
import SustainabilitySection from '../components/SustainabilitySection.astro';
import BlogCarousel from '../components/BlogCarousel.astro';
import TripPlanningCTA from '../components/TripPlanningCTA.astro';
import Footer from '../components/Footer.astro';
import MobileStickyBar from '../components/MobileStickyBar.astro';
import SectionDivider from '../components/SectionDivider.astro';
import { getSectionData } from '../lib/cms';
import { PropertySchema } from '../lib/schemas';
import type { PropertyData } from '../types/sections';

const fallbackMara: PropertyData = {
  location: 'Serengeti National Park, Tanzania',
  title: 'One Nature Mara River',
  description: 'Seven luxurious villas situated in the heart of the Great Migration River Crossing.',
  imageUrls: ['/images/mara-river/bedroom1.webp', '/images/mara-river/pool.webp', '/images/mara-river/bedroom2.webp'],
  ctaText: 'Know More',
  ctaLink: '/mara-river/',
};

const fallbackNya: PropertyData = {
  location: 'Serengeti National Park, Tanzania',
  title: 'One Nature Nyaruswiga',
  description: 'Fourteen ultra-luxurious tents nestled in the Central Serengeti.',
  imageUrls: ['/images/nyaruswiga/tent1.webp', '/images/nyaruswiga/family-lounge.webp', '/images/nyaruswiga/tent2.webp'],
  ctaText: 'Know More',
  ctaLink: '/nyaruswiga/',
  reversed: true,
};

const maraData = await getSectionData('section-property-mara-river', fallbackMara, PropertySchema);
const nyaData = await getSectionData('section-property-nyaruswiga', fallbackNya, PropertySchema);
---

<Layout>
  <Navigation />

  <HeroSlider>
    <BookingBar slot="booking" />
  </HeroSlider>

  <main>
    <AboutSection />

    <SectionDivider />

    <PropertyShowcase {...maraData} />

    <SectionDivider />

    <PropertyShowcase {...nyaData} />

    <SectionDivider />

    <WildernessSection />

    <SectionDivider />

    <ExperiencesSection />

    <SectionDivider />

    <SustainabilitySection />

    <SectionDivider />

    <BlogCarousel />

    <SectionDivider />

    <TripPlanningCTA />
  </main>

  <Footer />

  <MobileStickyBar />
</Layout>
