---
const today = new Date();
const tomorrow = new Date(today);
tomorrow.setDate(tomorrow.getDate() + 1);
const formatDate = (d: Date) => d.toISOString().split('T')[0];
---

<div class="bg-dark border-t border-gold/20">
  <div class="max-w-7xl mx-auto px-6 py-5">
    <form class="flex flex-col sm:flex-row items-end sm:items-center gap-4">
      <div class="flex-1 w-full">
        <label class="block font-heading text-xs tracking-wider uppercase text-gold-cream/50 mb-1.5">Property</label>
        <select class="w-full bg-transparent border-b border-gold/20 text-gold-cream/90 font-heading uppercase tracking-wider text-sm py-2 focus:outline-none focus:border-gold transition-colors">
          <option value="nyaruswiga" class="text-dark">One Nature Nyaruswiga</option>
          <option value="mara-river" class="text-dark">One Nature Mara River</option>
        </select>
      </div>
      <div class="flex-1 w-full">
        <label class="block font-heading text-xs tracking-wider uppercase text-gold-cream/50 mb-1.5">Check In</label>
        <input
          type="date"
          value={formatDate(today)}
          class="w-full bg-transparent border-b border-gold/20 text-gold-cream/90 font-heading uppercase tracking-wider text-sm py-2 focus:outline-none focus:border-gold transition-colors"
        />
      </div>
      <div class="flex-1 w-full">
        <label class="block font-heading text-xs tracking-wider uppercase text-gold-cream/50 mb-1.5">Check Out</label>
        <input
          type="date"
          value={formatDate(tomorrow)}
          class="w-full bg-transparent border-b border-gold/20 text-gold-cream/90 font-heading uppercase tracking-wider text-sm py-2 focus:outline-none focus:border-gold transition-colors"
        />
      </div>
      <button
        type="submit"
        class="bg-gold text-dark font-heading uppercase tracking-wider text-sm px-8 py-2.5 hover:bg-gold-cream transition-colors duration-300 w-full sm:w-auto sm:mt-5"
      >
        Book Now
      </button>
    </form>
  </div>
</div>
