---

<footer class="bg-dark">
  <div class="border-b border-gold/20">
    <div class="max-w-7xl mx-auto px-6 py-12">
      <div class="flex flex-col md:flex-row items-center justify-between gap-8">
        <img src={data.logoUrl} alt="Two Nature Hotels" class="h-10" />
        <div class="text-center md:text-left">
          <h3 class="font-heading uppercase tracking-wider text-gold-cream text-lg mb-2">
            {data.newsletterText}
          </h3>
          <p class="text-gold-cream/60 text-sm mb-4">{data.newsletterSubtext}</p>
        </div>
        <form class="flex w-full md:w-auto">
          <input
            type="email"
            placeholder="Your email address"
            class="bg-transparent border border-gold/30 text-gold-cream font-heading text-sm px-4 py-3 w-full md:w-72 focus:outline-none focus:border-gold transition-colors placeholder:text-gold-cream/40"
          />
          <button
            type="submit"
            class="bg-gold text-gold-cream font-heading uppercase tracking-wider text-sm px-6 py-3 hover:bg-dark hover:text-gold transition-all duration-300 whitespace-nowrap"
          >
            Subscribe
          </button>
        </form>
      </div>
    </div>
  </div>

  <div class="border-b border-gold/20">
    <div class="max-w-7xl mx-auto px-6 py-8">
      <nav class="flex flex-wrap justify-center gap-6 md:gap-10">
        {data.navItems.map((item) => (
          <a
            href={item.href}
            class="font-heading uppercase tracking-wider text-gold-cream/80 hover:text-gold transition-colors text-sm"
          >
            {item.label}
          </a>
        ))}
      </nav>
    </div>
  </div>

  <div class="border-b border-gold/20">
    <div class="max-w-7xl mx-auto px-6 py-10">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center md:text-left">
        <div>
          <h4 class="font-heading uppercase tracking-wider text-gold text-sm mb-4">Phone</h4>
          {data.phone.map((num) => (
            <a href={`tel:${num.replace(/\s/g, '')}`} class="block text-gold-cream/70 hover:text-gold transition-colors text-sm">{num}</a>
          ))}
        </div>
        <div>
          <h4 class="font-heading uppercase tracking-wider text-gold text-sm mb-4">Address</h4>
          <p class="text-gold-cream/70 text-sm">{data.address}</p>
        </div>
        <div>
          <h4 class="font-heading uppercase tracking-wider text-gold text-sm mb-4">Email</h4>
          <a href={`mailto:${data.email}`} class="text-gold-cream/70 hover:text-gold transition-colors text-sm">{data.email}</a>
        </div>
      </div>

      <div class="flex justify-center gap-5 mt-10">
        {data.socialLinks.map((social) => (
          <a
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-gold-cream/60 hover:text-gold transition-colors"
            aria-label={social.name}
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path set:html={socialIcons[social.icon] || ''}></path>
            </svg>
          </a>
        ))}
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-6 py-6">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4 text-center md:text-left">
      <p class="text-gold-cream/40 text-xs">
        Copyright &copy; {new Date().getFullYear()} TwoNatureHotels. All rights reserved.
      </p>
      <div class="flex gap-6">
        {data.legalLinks.map((link) => (
          <a href={link.href} class="text-gold-cream/40 hover:text-gold transition-colors text-xs">{link.label}</a>
        ))}
      </div>
    </div>
  </div>
</footer>
