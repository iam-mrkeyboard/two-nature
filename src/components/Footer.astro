  socialLinks: [
    { name: 'Facebook', href: 'https://www.facebook.com/onenatureresorts/', icon: 'facebook' },
    { name: 'Instagram', href: 'https://www.instagram.com/onenaturehotels/', icon: 'instagram' },
    { name: 'YouTube', href: 'https://www.youtube.com/@onenaturehotels', icon: 'youtube' },
    { name: 'TikTok', href: 'https://www.tiktok.com/@onenaturehotels', icon: 'tiktok' },
    { name: 'LinkedIn', href: 'https://www.linkedin.com/company/onenaturehotels', icon: 'linkedin' },
    { name: 'TripAdvisor', href: 'https://www.tripadvisor.com/', icon: 'tripadvisor' },
