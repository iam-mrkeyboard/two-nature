---
import GoldButton from './GoldButton.astro';
import ScrollAnimation from './ScrollAnimation.astro';

const tripImage = '/images/experiences/lioness-cub.webp';
---

<ScrollAnimation />

<section class="section-padding bg-gold-cream">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="fade-in">
        <h2 class="font-display text-4xl md:text-5xl font-semibold text-dark leading-tight mb-4">
          Let us plan your trip
        </h2>
        <p class="font-heading text-sm tracking-[0.15em] uppercase text-gold mb-8">
          Discover Your Perfect Escape and Customize Your Journey
        </p>
        <ul class="space-y-4 mb-8">
          <li class="flex items-center gap-4">
            <span class="flex items-center justify-center w-12 h-12 bg-gold/10 rounded-full flex-shrink-0">
              <svg class="w-6 h-6 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </span>
            <span class="text-dark font-heading uppercase tracking-wider text-sm">Expert Guidance</span>
          </li>
          <li class="flex items-center gap-4">
            <span class="flex items-center justify-center w-12 h-12 bg-gold/10 rounded-full flex-shrink-0">
              <svg class="w-6 h-6 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
              </svg>
            </span>
            <span class="text-dark font-heading uppercase tracking-wider text-sm">Personalized Itineraries</span>
          </li>
          <li class="flex items-center gap-4">
            <span class="flex items-center justify-center w-12 h-12 bg-gold/10 rounded-full flex-shrink-0">
              <svg class="w-6 h-6 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
              </svg>
            </span>
            <span class="text-dark font-heading uppercase tracking-wider text-sm">Tailored Services</span>
          </li>
        </ul>
        <GoldButton href="/contact-us/" text="Contact Us" />
      </div>
      <div class="fade-in">
        <img
          src={tripImage}
          alt="Lioness and cub in the Serengeti"
          class="w-full h-auto rounded shadow-xl"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>
