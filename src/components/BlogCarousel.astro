---
import ScrollAnimation from './ScrollAnimation.astro';

const blogPosts = [
  {
    title: 'Giraffes of the Serengeti',
    category: 'Animals',
    date: 'Jan 15',
    image: 'https://onenaturehotels.com/wp-content/uploads/2024/01/Blog-Giraffes.webp',
    href: '/blog/giraffes-of-the-serengeti/',
  },
  {
    title: 'Dung Architects: The Unsung Engineers of the Serengeti',
    category: 'Animals',
    date: 'Jan 10',
    image: 'https://onenaturehotels.com/wp-content/uploads/2024/01/Blog-Dung-Beetles.webp',
    href: '/blog/dung-architects/',
  },
  {
    title: "Nature's Masterpieces: The Hidden Purpose Behind Animal Patterns",
    category: 'Conservation',
    date: 'Jan 05',
    image: 'https://onenaturehotels.com/wp-content/uploads/2024/01/Blog-Animal-Patterns.webp',
    href: '/blog/natures-masterpieces/',
  },
  {
    title: 'Why Serengeti Holidays with Families and Friends Are Best for the Festive Season',
    category: 'Highlights',
    date: 'Dec 20',
    image: 'https://onenaturehotels.com/wp-content/uploads/2023/12/Blog-Festive-Season.webp',
    href: '/blog/serengeti-holidays-families/',
  },
  {
    title: 'Wildlife Conservation: How Two Nature Stands Tall',
    category: 'Conservation',
    date: 'Dec 15',
    image: 'https://onenaturehotels.com/wp-content/uploads/2023/12/Blog-Conservation.webp',
    href: '/blog/wildlife-conservation/',
  },
  {
    title: "Valentine's Day Getaway 2026",
    category: 'Highlights',
    date: 'Dec 10',
    image: 'https://onenaturehotels.com/wp-content/uploads/2023/12/Blog-Valentines.webp',
    href: '/blog/valentines-day-getaway/',
  },
  {
    title: '10 Best Animals to See in the Serengeti',
    category: 'Animals',
    date: 'Dec 05',
    image: 'https://onenaturehotels.com/wp-content/uploads/2023/12/Blog-Best-Animals.webp',
    href: '/blog/10-best-animals/',
  },
  {
    title: 'Spring Break in the Serengeti',
    category: 'Highlights',
    date: 'Nov 28',
    image: 'https://onenaturehotels.com/wp-content/uploads/2023/11/Blog-Spring-Break.webp',
    href: '/blog/spring-break-serengeti/',
  },
];
---

<ScrollAnimation />

<section class="section-padding bg-gold-beige">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-12 fade-in">
      <span class="block font-heading text-sm tracking-[0.2em] uppercase text-gold mb-3">
        News, Articles, & More
      </span>
      <h2 class="font-display text-4xl md:text-5xl font-semibold text-dark">Blog</h2>
    </div>

    <div class="swiper blog-carousel fade-in">
      <div class="swiper-wrapper">
        {blogPosts.map((post) => (
          <div class="swiper-slide">
            <a href={post.href} class="block bg-gold-cream rounded overflow-hidden shadow-md hover:shadow-xl transition-shadow duration-300">
              <div class="relative">
                <img src={post.image} alt={post.title} class="w-full h-56 object-cover" loading="lazy" />
                <div class="absolute top-4 left-4 bg-gold text-gold-cream font-heading uppercase tracking-wider text-xs px-3 py-1.5">
                  {post.category}
                </div>
                <div class="absolute bottom-4 left-4 bg-dark/80 backdrop-blur-sm text-gold-cream text-center px-3 py-2 min-w-[60px]">
                  <span class="block font-heading text-xs uppercase leading-none">{post.date.split(' ')[0]}</span>
                  <span class="block font-display text-xl font-semibold leading-none mt-1">{post.date.split(' ')[1]}</span>
                </div>
              </div>
              <div class="p-5">
                <h3 class="font-display text-lg font-semibold text-dark leading-snug line-clamp-2">
                  {post.title}
                </h3>
              </div>
            </a>
          </div>
        ))}
      </div>
      <div class="swiper-button-prev"></div>
      <div class="swiper-button-next"></div>
    </div>
  </div>
</section>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.css" />
<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var el = document.querySelector('.blog-carousel');
    if (el && typeof Swiper !== 'undefined') {
      new Swiper(el, {
        slidesPerView: 1,
        spaceBetween: 24,
        navigation: {
          nextEl: el.querySelector('.swiper-button-next'),
          prevEl: el.querySelector('.swiper-button-prev'),
        },
        breakpoints: {
          640: { slidesPerView: 2 },
          1024: { slidesPerView: 3 },
          1280: { slidesPerView: 4 },
        },
      });
    }
  });
</script>
