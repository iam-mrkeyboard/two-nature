---
import ScrollAnimation from './ScrollAnimation.astro';

const blogPosts = [
  {
    title: "Nature's Masterpieces: The Hidden Purpose Behind Animal Patterns in the Serengeti",
    category: 'Animals',
    date: 'Sep 08',
    image: '/images/blog/animal-patterns.webp',
    href: '/blog/natures-masterpieces/',
  },
  {
    title: 'Why Serengeti Holidays with Families and Friends Are Best for the Festive Season',
    category: 'Highlights',
    date: 'Nov 20',
    image: '/images/blog/festive.webp',
    href: '/blog/serengeti-holidays-families/',
  },
  {
    title: 'Wildlife Conservation: How Two Nature Stands Tall for Wildlife and Communities',
    category: 'Conservation',
    date: 'Dec 03',
    image: '/images/blog/conservation.webp',
    href: '/blog/wildlife-conservation/',
  },
  {
    title: 'Giraffes of the Serengeti: What Makes Them So Special',
    category: 'Animals',
    date: 'Jan 15',
    image: '/images/blog/giraffes.webp',
    href: '/blog/giraffes-of-the-serengeti/',
  },
  {
    title: 'Dung Architects: The Unsung Engineers of the Serengeti (And Why They Matter to Your Safari!)',
    category: 'Animals',
    date: 'Jan 10',
    image: '/images/blog/dung-beetles.webp',
    href: '/blog/dung-architects/',
  },
  {
    title: "Valentine's Day Getaway 2026",
    category: 'Highlights',
    date: 'Dec 10',
    image: '/images/blog/valentines.webp',
    href: '/blog/valentines-day-getaway/',
  },
  {
    title: '10 Best Animals to See in the Serengeti',
    category: 'Animals',
    date: 'Dec 05',
    image: '/images/blog/best-animals.webp',
    href: '/blog/10-best-animals/',
  },
  {
    title: 'Spring Break in the Serengeti',
    category: 'Highlights',
    date: 'Nov 28',
    image: '/images/blog/spring-break.webp',
    href: '/blog/spring-break-serengeti/',
  },
];
---

<ScrollAnimation />

<section class="section-padding bg-gold-beige">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-12 fade-in">
      <span class="block font-heading text-sm tracking-[0.2em] uppercase text-gold mb-3">
        News, Articles, & More
      </span>
      <h2 class="font-display text-4xl md:text-5xl font-semibold text-dark">Blog</h2>
    </div>

    <div class="swiper blog-carousel fade-in relative">
      <div class="swiper-wrapper">
        {blogPosts.map((post) => (
          <div class="swiper-slide">
            <a href={post.href} class="block relative group h-[520px] w-full overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-300">
              <!-- Image (with scale fix for giraffes letterboxing) -->
              <img 
                src={post.image} 
                alt={post.title} 
                class={`absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 ${post.image.includes('giraffes.webp') ? 'scale-135 object-center' : ''}`} 
                loading="lazy" 
              />
              
              <!-- Date Overlay -->
              <div class="absolute top-6 left-6 border border-white/30 text-white text-center px-3 py-1.5 min-w-[55px] bg-black/10 backdrop-blur-[2px]">
                <span class="block font-heading text-[10px] uppercase tracking-widest leading-none text-white/95">{post.date.split(' ')[0]}</span>
                <span class="block font-display text-2xl font-normal leading-none mt-1">{post.date.split(' ')[1]}</span>
              </div>

              <!-- Content Box (Pure White, Floating) -->
              <div class="absolute bottom-6 left-6 right-6 bg-white p-6 pb-8 shadow-sm">
                <span class="block font-heading text-[11px] tracking-[0.2em] uppercase text-gold mb-3">
                  {post.category}
                </span>
                <h3 class="font-display text-lg font-semibold text-dark leading-snug line-clamp-3">
                  {post.title}
                </h3>
              </div>
            </a>
          </div>
        ))}
      </div>
      <!-- Swiper Navigation Arrows -->
      <div class="swiper-button-prev"></div>
      <div class="swiper-button-next"></div>
    </div>
  </div>
</section>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.css" />
<script is:inline src="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.js"></script>
<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var el = document.querySelector('.blog-carousel');
    if (el && typeof Swiper !== 'undefined') {
      new Swiper(el, {
        slidesPerView: 1,
        spaceBetween: 24,
        loop: true,
        navigation: {
          nextEl: el.querySelector('.swiper-button-next'),
          prevEl: el.querySelector('.swiper-button-prev'),
        },
        breakpoints: {
          640: { slidesPerView: 2 },
          1024: { slidesPerView: 3 },
        },
      });
    }
  });
</script>
