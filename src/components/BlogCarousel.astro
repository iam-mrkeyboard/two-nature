---
import ScrollAnimation from './ScrollAnimation.astro';
import { getSectionData } from '../lib/cms';
import { BlogCarouselSchema } from '../lib/schemas';
import type { BlogCarouselData } from '../types/sections';

const fallback: BlogCarouselData = {
  subtitle: 'News, Articles, & More',
  title: 'Blog',
  posts: [
    {
      title: "Nature's Masterpieces: The Hidden Purpose Behind Animal Patterns in the Serengeti",
      category: 'Animals',
      date: 'Sep 08',
      image: '/images/blog/animal-patterns.webp',
      href: '/blog/natures-masterpieces/',
    },
    {
      title: 'Why Serengeti Holidays with Families and Friends Are Best for the Festive Season',
      category: 'Highlights',
      date: 'Nov 20',
      image: '/images/blog/festive.webp',
      href: '/blog/serengeti-holidays-families/',
    },
    {
      title: 'Wildlife Conservation: How Two Nature Stands Tall for Wildlife and Communities',
      category: 'Conservation',
      date: 'Dec 03',
      image: '/images/blog/conservation.webp',
      href: '/blog/wildlife-conservation/',
    },
    {
      title: 'Giraffes of the Serengeti: What Makes Them So Special',
      category: 'Animals',
      date: 'Jan 15',
      image: '/images/blog/giraffes.webp',
      href: '/blog/giraffes-of-the-serengeti/',
    },
    {
      title: 'Dung Architects: The Unsung Engineers of the Serengeti (And Why They Matter to Your Safari!)',
      category: 'Animals',
      date: 'Jan 10',
      image: '/images/blog/dung-beetles.webp',
      href: '/blog/dung-architects/',
    },
    {
      title: "Valentine's Day Getaway 2026",
      category: 'Highlights',
      date: 'Dec 10',
      image: '/images/blog/valentines.webp',
      href: '/blog/valentines-day-getaway/',
    },
    {
      title: '10 Best Animals to See in the Serengeti',
      category: 'Animals',
      date: 'Dec 05',
      image: '/images/blog/best-animals.webp',
      href: '/blog/10-best-animals/',
    },
    {
      title: 'Spring Break in the Serengeti',
      category: 'Highlights',
      date: 'Nov 28',
      image: '/images/blog/spring-break.webp',
      href: '/blog/spring-break-serengeti/',
    },
  ],
};

const data = await getSectionData('section-blog-carousel', fallback, BlogCarouselSchema);
---

<ScrollAnimation />

<section class="section-padding bg-ivory">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-14 fade-in">
      <span class="block font-heading text-xs tracking-[0.25em] uppercase text-text mb-3">
        {data.subtitle}
      </span>
      <h2 class="font-display text-[clamp(2rem,5vw,3.5rem)] text-dark font-normal">{data.title}</h2>
    </div>

    <div class="swiper blog-carousel fade-in relative">
      <div class="swiper-wrapper">
        {data.posts.map((post) => (
          <div class="swiper-slide">
            <a href={post.href} class="block group">
              <div class="aspect-[4/3] overflow-hidden bg-ivory">
                <img 
                  src={post.image} 
                  alt={post.title} 
                  class={`w-full h-full object-cover transition-transform duration-700 group-hover:scale-102 ${post.image.includes('giraffes.webp') ? 'scale-135 object-center' : ''}`} 
                  loading="lazy" 
                />
              </div>
              <div class="pt-5">
                <span class="block font-heading text-xs tracking-[0.2em] uppercase text-text mb-2">
                  {post.category}
                </span>
                <h3 class="font-display text-xl text-dark font-normal leading-snug">
                  {post.title}
                </h3>
                <span class="block text-text/60 text-sm mt-3">{post.date}</span>
              </div>
            </a>
          </div>
        ))}
      </div>
      <div class="swiper-button-prev"></div>
      <div class="swiper-button-next"></div>
    </div>
  </div>
</section>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.css" />
<style is:inline>
.blog-carousel .swiper-button-prev,
.blog-carousel .swiper-button-next {
  color: #C8A977;
  background: rgba(26, 23, 20, 0.85);
  border: 1px solid rgba(200, 169, 119, 0.25);
  border-radius: 50%;
  width: 44px;
  height: 44px;
  transition: all 0.3s ease;
}
.blog-carousel .swiper-button-prev:hover,
.blog-carousel .swiper-button-next:hover {
  color: #1A1714;
  background: #C8A977;
  border-color: #C8A977;
}
.blog-carousel .swiper-button-prev::after,
.blog-carousel .swiper-button-next::after {
  font-size: 16px;
  font-weight: 400;
}
</style>
<script is:inline src="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.js"></script>
<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var el = document.querySelector('.blog-carousel');
    if (el && typeof Swiper !== 'undefined') {
      new Swiper(el, {
        slidesPerView: 1,
        spaceBetween: 32,
        loop: true,
        navigation: {
          nextEl: el.querySelector('.swiper-button-next'),
          prevEl: el.querySelector('.swiper-button-prev'),
        },
        breakpoints: {
          640: { slidesPerView: 2 },
          1024: { slidesPerView: 3 },
        },
      });
    }
  });
</script>
