---
interface Props {
  images: string[];
  class?: string;
}

const { images, class: className = '' } = Astro.props;
const carouselId = `carousel-${Math.random().toString(36).slice(2, 8)}`;
---

<div class={`swiper onenature-carousel ${className}`} id={carouselId}>
  <div class="swiper-wrapper">
    {images.map((src) => (
      <div class="swiper-slide">
        <img src={src} alt="" class="w-full h-[300px] md:h-[400px] object-cover" loading="lazy" />
      </div>
    ))}
  </div>
  <div class="swiper-button-prev"></div>
  <div class="swiper-button-next"></div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.css" />
<style>
  .onenature-carousel .swiper-button-prev,
  .onenature-carousel .swiper-button-next {
    color: #C8A977 !important;
    background: rgba(26, 23, 20, 0.85) !important;
    border: 1px solid rgba(200, 169, 119, 0.25) !important;
    border-radius: 50% !important;
    width: 44px !important;
    height: 44px !important;
    transition: all 0.3s ease !important;
  }
  .onenature-carousel .swiper-button-prev:hover,
  .onenature-carousel .swiper-button-next:hover {
    color: #1A1714 !important;
    background: #C8A977 !important;
    border-color: #C8A977 !important;
  }
  .onenature-carousel .swiper-button-prev::after,
  .onenature-carousel .swiper-button-next::after {
    font-size: 16px !important;
    font-weight: 400 !important;
  }
</style>
<script is:inline define:vars={{ carouselId }}>
  document.addEventListener('DOMContentLoaded', function() {
    var el = document.getElementById(carouselId);
    if (el && typeof Swiper !== 'undefined') {
      new Swiper(el, {
        effect: 'fade',
        fadeEffect: { crossFade: true },
        speed: 800,
        navigation: {
          nextEl: el.querySelector('.swiper-button-next'),
          prevEl: el.querySelector('.swiper-button-prev'),
        },
      });
    }
  });
</script>
