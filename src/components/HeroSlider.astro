---
import StarRating from './StarRating.astro';
import { getSectionData } from '../lib/cms';

interface HeroData {
  subtitle: string;
  title: string;
  backgroundImage: string;
  showStars: boolean;
}

const fallback: HeroData = {
  subtitle: 'One People. One Planet. One Nature.',
  title: 'Embrace Nature',
  backgroundImage: '/images/hero/banner.webp',
  showStars: true,
};

const data = await getSectionData<HeroData>('section-hero', fallback);
---

<section class="relative h-screen min-h-[600px] flex flex-col justify-center items-center">
  <div class="absolute inset-0">
    <img
      src={data.backgroundImage}
      alt={data.title}
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-dark/40 via-dark/20 to-dark/60"></div>
  </div>

  <div class="relative z-10 text-center px-6 max-w-3xl">
    {data.showStars && <StarRating color="#C8A977" />}
    <p class="font-heading uppercase tracking-[0.25em] text-gold-cream/90 text-sm md:text-base mt-6 mb-4">
      {data.subtitle}
    </p>
    <h1 class="font-display text-5xl md:text-7xl lg:text-8xl text-gold-cream font-semibold leading-tight">
      {data.title}
    </h1>
  </div>

  <div class="absolute bottom-0 left-0 right-0 z-20">
    <slot name="booking" />
  </div>
</section>
