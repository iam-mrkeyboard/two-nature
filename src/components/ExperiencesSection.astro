---
import ScrollAnimation from './ScrollAnimation.astro';
import ImageCarousel from './ImageCarousel.astro';

const experienceImages = [
  'https://onenaturehotels.com/wp-content/uploads/2023/09/ONH-Home-Banner-2-2023.webp',
  'https://onenaturehotels.com/wp-content/uploads/2024/01/Homepage-sect5-balloon-safari.webp',
];
---

<ScrollAnimation />

<section class="section-padding bg-gold-cream">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="fade-in">
        <ImageCarousel images={experienceImages} class="rounded shadow-xl" />
      </div>
      <div class="fade-in">
        <span class="block font-heading text-sm tracking-[0.2em] uppercase text-gold mb-3">
          Experiences
        </span>
        <h2 class="font-display text-4xl md:text-5xl font-semibold text-dark leading-tight mb-6">
          Enriching Experiences Await with Every Stay
        </h2>
        <p class="text-text leading-relaxed mb-6">
          From cultural delights to gastronomic experiences and thrilling adventures, every moment at Two Nature Hotels is designed to create lasting memories. Discover the magic of the Serengeti through our curated experiences.
        </p>
        <ul class="space-y-3 text-text">
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 text-gold flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Hot Air Balloon Safaris
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 text-gold flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Guided Game Drives
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 text-gold flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Cultural Village Visits
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 text-gold flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Bush Dining Experiences
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
