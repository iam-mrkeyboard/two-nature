---
import ScrollAnimation from './ScrollAnimation.astro';
import ImageCarousel from './ImageCarousel.astro';
import { getSectionData } from '../lib/cms';

interface ExperiencesData {
  subtitle: string;
  title: string;
  description: string;
  imageUrls: string[];
  features: string[];
}

const fallback: ExperiencesData = {
  subtitle: 'Experiences',
  title: 'Enriching Experiences Await with Every Stay',
  description: 'From cultural delights to gastronomic experiences and thrilling adventures, every moment at Two Nature Hotels is designed to create lasting memories.',
  imageUrls: ['/images/hero/banner.webp', '/images/experiences/balloon-safari.webp'],
  features: ['Hot Air Balloon Safaris', 'Guided Game Drives', 'Cultural Village Visits', 'Bush Dining Experiences'],
};

const data = await getSectionData<ExperiencesData>('section-experiences', fallback);
---

<ScrollAnimation />

<section class="section-padding bg-gold-cream">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="fade-in">
        <ImageCarousel images={data.imageUrls} class="rounded shadow-xl" />
      </div>
      <div class="fade-in">
        <span class="block font-heading text-sm tracking-[0.2em] uppercase text-gold mb-3">
          {data.subtitle}
        </span>
        <h2 class="font-display text-4xl md:text-5xl font-semibold text-dark leading-tight mb-6">
          {data.title}
        </h2>
        <p class="text-text leading-relaxed mb-6">
          {data.description}
        </p>
        <ul class="space-y-3 text-text">
          {data.features.map((feature) => (
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-gold flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              {feature}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
