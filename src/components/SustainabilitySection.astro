---
import ScrollAnimation from './ScrollAnimation.astro';

---

<ScrollAnimation />

<section class="section-padding bg-dark relative overflow-hidden">
  <div class="absolute inset-0 opacity-10">
    <img
      src="https://onenaturehotels.com/wp-content/uploads/2023/09/ONH-Home-Banner-1-2023.webp"
      alt=""
      class="w-full h-full object-cover"
    />
  </div>
  <div class="relative z-10 max-w-4xl mx-auto px-6 text-center fade-in">
    <span class="block font-heading text-sm tracking-[0.2em] uppercase text-gold mb-6">
      Sustainability
    </span>
    <h2 class="font-display text-4xl md:text-5xl font-semibold text-gold-cream leading-tight mb-8">
      Preservation and Luxury Unite
    </h2>
    <p class="text-gold-cream/70 leading-relaxed mb-8 max-w-2xl mx-auto">
      Our eco-friendly accommodations and conservation initiatives ensure that the beauty of Africa is preserved for generations to come. We believe in responsible tourism that benefits both the environment and local communities.
    </p>
    <p class="font-heading text-sm tracking-[0.2em] uppercase text-gold mb-6">
      One People. One Planet. One Nature.
    </p>
    <blockquote class="font-display text-2xl md:text-3xl text-gold-cream/90 italic leading-relaxed max-w-3xl mx-auto">
      "Beyond a stay, it is a captivating journey — a shared heartbeat with the Earth."
    </blockquote>
  </div>
</section>
