---
import ScrollAnimation from './ScrollAnimation.astro';
import { getSectionData } from '../lib/cms';
import { SustainabilitySchema } from '../lib/schemas';
import type { SustainabilityData } from '../types/sections';

const fallback: SustainabilityData = {
  subtitle: 'Sustainability',
  title: 'Preservation and Luxury Unite',
  description: 'Our eco-friendly accommodations and conservation initiatives ensure that the beauty of Africa is preserved for generations to come.',
  motto: 'One People. One Planet. One Nature.',
  quote: 'Beyond a stay, it is a captivating journey — a shared heartbeat with the Earth.',
  bgImage: '/images/hero/banner.webp',
};

const data = await getSectionData('section-sustainability', fallback, SustainabilitySchema);
---

<ScrollAnimation />

<section class="section-padding bg-dark relative overflow-hidden">
  <div class="absolute inset-0 opacity-10">
    <img
      src={data.bgImage}
      alt=""
      class="w-full h-full object-cover"
    />
  </div>
  <div class="absolute inset-0" style="background: radial-gradient(ellipse at center, transparent 30%, rgba(26,23,20,0.6) 100%)"></div>
  <div class="relative z-10 max-w-4xl mx-auto px-6 text-center fade-in stagger-children">
    <div class="h-px w-24 bg-gold/40 mx-auto mb-6"></div>
    <span class="block font-heading text-sm tracking-[0.25em] uppercase text-gold mb-6">
      {data.subtitle}
    </span>
    <h2 class="font-display text-[clamp(2rem,5vw,3.5rem)] text-gold-cream font-normal leading-[1.2] tracking-tight mb-8">
      {data.title}
    </h2>
    <p class="text-gold-cream/70 leading-[1.65] mb-8 max-w-2xl mx-auto">
      {data.description}
    </p>
    <p class="font-heading text-sm tracking-[0.2em] uppercase text-gold mb-6">
      {data.motto}
    </p>
    <blockquote class="font-display text-2xl md:text-3xl text-gold-cream/90 italic leading-relaxed max-w-3xl mx-auto">
      "{data.quote}"
    </blockquote>
  </div>
</section>
