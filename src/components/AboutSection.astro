---
import StarRating from './StarRating.astro';
import GoldButton from './GoldButton.astro';
import ScrollAnimation from './ScrollAnimation.astro';

const aboutImage = '/images/about/leopard.webp';
---

<ScrollAnimation />

<section class="section-padding bg-gold-beige">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="fade-in">
        <StarRating color="#C8A977" />
        <span class="block font-heading text-sm tracking-[0.2em] uppercase text-gold mt-6 mb-3">
          Two Nature Hotels
        </span>
        <h2 class="font-display text-4xl md:text-5xl font-semibold text-dark leading-tight mb-6">
          Embrace Nature, Experience Luxury
        </h2>
        <p class="text-text leading-relaxed mb-8">
          Two Nature Hotels is a collection of ultra-luxury boutique hotels and camps that balance premium luxury with unwavering ecological responsibility. Our properties offer an exclusive and intimate safari experience in the heart of the Serengeti.
        </p>
        <GoldButton href="/about-us/" text="Know More" />
      </div>
      <div class="fade-in">
        <img
          src={aboutImage}
          alt="African leopard in the Serengeti"
          class="w-full h-auto rounded shadow-xl"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>
