---
import StarRating from './StarRating.astro';
import GoldButton from './GoldButton.astro';
import ScrollAnimation from './ScrollAnimation.astro';
import { getSectionData } from '../lib/cms';
import { AboutSchema } from '../lib/schemas';
import type { AboutData } from '../types/sections';

const fallback: AboutData = {
  subtitle: 'Two Nature Hotels',
  title: 'Embrace Nature, Experience Luxury',
  description: 'Two Nature Hotels is a collection of ultra-luxury boutique hotels and camps that balance premium luxury with unwavering ecological responsibility.',
  imageUrl: '/images/about/leopard.webp',
  ctaText: 'Know More',
  ctaLink: '/about-us/',
};

const data = await getSectionData('section-about', fallback, AboutSchema);
---

<ScrollAnimation />

<section class="section-padding bg-gold-beige">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="fade-in">
        <StarRating color="#C8A977" />
        <span class="block font-heading text-sm tracking-[0.2em] uppercase text-gold mt-6 mb-3">
          {data.subtitle}
        </span>
        <h2 class="font-display text-4xl md:text-5xl font-semibold text-dark leading-tight mb-6">
          {data.title}
        </h2>
        <p class="text-text leading-relaxed mb-8">
          {data.description}
        </p>
        <GoldButton href={data.ctaLink} text={data.ctaText} />
      </div>
      <div class="fade-in">
        <img
          src={data.imageUrl}
          alt={data.title}
          class="w-full h-auto rounded shadow-xl"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>
