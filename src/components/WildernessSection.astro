---
import ScrollAnimation from './ScrollAnimation.astro';
import { getSectionData } from '../lib/cms';
import { WildernessSchema } from '../lib/schemas';
import type { WildernessData } from '../types/sections';

const fallback: WildernessData = {
  title: 'Where Comfort and Luxury Meet Wilderness',
  description: 'Our exclusive and secluded destinations offer the perfect blend of premium comfort and raw natural beauty.',
  imageUrl: '/images/experiences/safari-drive.webp',
};

const data = await getSectionData('section-wilderness', fallback, WildernessSchema);
---

<ScrollAnimation />

<section class="section-padding bg-gold-beige">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="fade-in">
        <h2 class="font-display text-4xl md:text-5xl font-semibold text-dark leading-tight mb-6">
          {data.title}
        </h2>
        <p class="text-text leading-relaxed">
          {data.description}
        </p>
      </div>
      <div class="fade-in">
        <img
          src={data.imageUrl}
          alt={data.title}
          class="w-full h-auto rounded shadow-xl"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>
