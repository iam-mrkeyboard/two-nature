---
import ScrollAnimation from './ScrollAnimation.astro';

const wildernessImage = 'https://onenaturehotels.com/wp-content/uploads/2024/01/Homepage-sect4-safari-drive.webp';
---

<ScrollAnimation />

<section class="section-padding bg-gold-beige">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="fade-in">
        <h2 class="font-display text-4xl md:text-5xl font-semibold text-dark leading-tight mb-6">
          Where Comfort and Luxury Meet Wilderness
        </h2>
        <p class="text-text leading-relaxed">
          Our exclusive and secluded destinations offer the perfect blend of premium comfort and raw natural beauty. Each property is carefully designed to immerse you in the African wilderness while providing world-class amenities and service.
        </p>
      </div>
      <div class="fade-in">
        <img
          src={wildernessImage}
          alt="The Great Migration safari drive"
          class="w-full h-auto rounded shadow-xl"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>
